--- a/kernel/common/inc/nv-linux.h
+++ b/kernel/common/inc/nv-linux.h
@@ -1697,5 +1697,23 @@
 #include <linux/dma-buf.h>
 #include <linux/gpio.h>
-#include <linux/of_gpio.h>
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 12, 0)
+/*
+ * Linux 6.12+ removed <linux/of_gpio.h> and the legacy of_get_named_gpio()
+ * helper (commit 51aaf65bbd21 "gpio: of: Remove <linux/of_gpio.h>").
+ * Those were only used for Tegra MIPI DSI panels, which are never exercised
+ * on x86. Provide a stub so the module still compiles on new kernels.
+ */
+#include <linux/errno.h>
+struct device_node;
+static inline int of_get_named_gpio(struct device_node *dev, const char *name, int index)
+{
+    (void)dev;
+    (void)name;
+    (void)index;
+    return -ENODEV;
+}
+#else
+#include <linux/of_gpio.h>
+#endif
 #include <linux/of_device.h>
 #include <linux/of_platform.h>
